{
    "version": "2.0.0",
    "tasks": [
        {
            // Ctrl+Shift+B: builds the program of the active file without
            // starting Xemu.
            "label": "MEGA65: Build (active program)",
            "type": "shell",
            "command": "${workspaceFolder}/.vscode/run-current.sh",
            "args": [
                "${file}"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "MEGA65_RUN": "0"
                }
            },
            // clang messages: file:line:column: error: text
            "problemMatcher": {
                "owner": "llvm-mos",
                "fileLocation": "absolute",
                "pattern": {
                    "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error|fatal error|note):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            // Like F5, just as a task: build and start in Xemu.
            "label": "MEGA65: Build & Run (active program)",
            "type": "shell",
            "command": "${workspaceFolder}/.vscode/run-current.sh",
            "args": [
                "${file}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            // Builds the program of the active file with -DSCREENCAST and
            // records it as build/<program>.mp4 with sound (headless, no
            // window). The program plays itself and ends the recording;
            // see toolchain/tools/bin/mega65-cast.
            "label": "MEGA65: Record screencast (active program)",
            "type": "shell",
            "command": "${workspaceFolder}/.vscode/run-current.sh",
            "args": [
                "${file}"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "MEGA65_CAST": "1"
                }
            },
            "problemMatcher": []
        },
        {
            // Start Xemu without a program (BASIC 65).
            "label": "MEGA65: Start Xemu",
            "type": "shell",
            "command": "${workspaceFolder}/toolchain/tools/bin/xmega65",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            // Insert a demo disk from toolchain/disks and start its first
            // program (Xemu types RUN "*).
            "label": "MEGA65: Run demo disk",
            "type": "shell",
            "command": "${workspaceFolder}/toolchain/tools/bin/xmega65",
            "args": [
                "-8",
                "toolchain/disks/${input:demoDisk}",
                "-autoload"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "demoDisk",
            "type": "pickString",
            "description": "Demo disk",
            "options": [
                { "label": "Flying Craft (full color mode)", "value": "demos-fcm.d81" },
                { "label": "IFF image slideshow", "value": "slideshow.d81" },
                { "label": "Palette editor", "value": "palette-editor1.d81" },
                { "label": "Character editor (full color mode)", "value": "char-editor-fcm3.d81" }
            ],
            "default": "demos-fcm.d81"
        }
    ]
}
