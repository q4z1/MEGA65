{
    "version": "2.0.0",
    "tasks": [
        {
            // Ctrl+Shift+B: builds the program of the active file without
            // starting Xemu.
            "label": "MEGA65: Build (active program)",
            "type": "shell",
            "command": "${workspaceFolder}/.vscode/run-current.sh",
            "args": [
                "${file}"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "MEGA65_RUN": "0"
                }
            },
            // clang messages: file:line:column: error: text
            "problemMatcher": {
                "owner": "llvm-mos",
                "fileLocation": "absolute",
                "pattern": {
                    "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error|fatal error|note):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            // Like F5, just as a task: build and start in Xemu.
            "label": "MEGA65: Build & Run (active program)",
            "type": "shell",
            "command": "${workspaceFolder}/.vscode/run-current.sh",
            "args": [
                "${file}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            // Start Xemu without a program (BASIC 65).
            "label": "MEGA65: Start Xemu",
            "type": "shell",
            "command": "${workspaceFolder}/toolchain/tools/bin/xmega65",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}
