; A test file for tools/cavekit.py: every kind of object GDash draws,
; random fills of both kinds, a map with map codes, an intermission. The
; maps it must give are in expected.txt (written by GDash's own code).
[BDCFF]
Version=0.5
[game]
Name=cavekit test
Author=Smaragd Dash
Caves=4
Levels=5
[mapcodes]
Length=1
%=WALL
[/mapcodes]

[cave]
Name=Objects
Size=40 22 0 0 39 21
CaveTime=150 140 130 120 110
DiamondsRequired=12 13 14 15 16
DiamondValue=10 15
CaveScheduling=bd1
PALTiming=true
CaveDelay=12 6 3 1 0
RandSeed=10 11 12 13 14
RandomFill=SPACE 60 BOULDER 50 DIAMOND 9 FIREFLYl 2
AmoebaTime=20
MagicWallTime=15
BorderProperties.lineshift=true
BorderProperties.objectwraparound=true

[objects]
