AddBackward=0 1 MAGICWALL SPACE
CopyPaste=1 1 8 5 1 15 mirror flip
Point=41 3 BOULDER
[Level=2,3]
Point=38 1 AMOEBA
[/Level]
Point=3 2 INBOX
Point=39 16 OUTBOX
[/objects]
[/cave]

