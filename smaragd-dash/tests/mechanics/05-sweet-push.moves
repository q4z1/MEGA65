# Rockford stands at the inbox, the waiting boulder right of him
R R R             # pushed every time
= @5,1=WAITING_STONE p=4,1
3L 4D R R         # down the shaft to the mega boulder
R R R             # without the sweet it does not move
= @4,5=MEGA_STONE p=3,5
L L U U R         # the sweet
= sweet=1
R R               # the boulder goes at once now
= @5,3=STONE p=4,3
3L D D R R R      # and the mega boulder too
= @5,5=MEGA_STONE p=4,5
3L D D            # the chasing boulder, which has come towards Rockford
= @2,7=CHASING_STONE
R                 # pushed: with the sweet it goes
= @3,7=CHASING_STONE p=2,7
