u                 # put down above him, ticking
= @2,5=BOMB_TICK* @2,6=PLAYER
R R R             # away, onto the rocket launcher
= @5,6=PLAYER_ROCKET_LAUNCHER
8.                # the bomb goes off
u                 # a rocket up
= has=ROCKET_2
r                 # right
= has=ROCKET_1
l                 # left
= has=ROCKET_3
d                 # down
= has=ROCKET_4 @5,6=PLAYER_ROCKET_LAUNCHER
20.               # they fly and blow up at the walls; Rockford keeps the launcher
= st=living no=ROCKET_1 no=ROCKET_2 no=ROCKET_3 no=ROCKET_4
