#!/bin/sh
# Starts Xemu/MEGA65 (toolchain/xemu) with the self-built
# toolchain/rom/MEGA65.ROM. All arguments are passed on to Xemu, e.g.:
#
#   xmega65 -prg build/main.prg      load and run a program
#   xmega65 -8 disk.d81              D81 image as drive 8
#
# Xemu runs directly inside the VS Code Flatpak sandbox (it was built there).
# Its settings and the SD card image live in ~/.local/share/xemu-lgb/mega65/;
# inside the sandbox XDG_DATA_HOME would point to ~/.var/app/... instead, so
# it is set explicitly here.

export XDG_DATA_HOME="$HOME/.local/share"

# Xemu's menu (right click) is a GTK popup. Under Wayland GTK cannot open it
# over the SDL window - the menu is then simply missing. With X11 (XWayland)
# it works; without DISPLAY, however, GTK would not start at all.
if [ -n "$DISPLAY" ] && [ -z "$GDK_BACKEND" ]; then
    export GDK_BACKEND=x11
fi

# Gamepads: Xemu reads every SDL joystick as the one joystick of its port
# (default 2): left stick and D-pad move, any button fires. On the Steam Deck
# its built-in controller (28de:1205) is a joystick too and would fight an
# external gamepad over that port, so it is hidden from SDL as soon as
# another joystick is connected. MEGA65_PAD_IGNORE overrides the list
# (vendor/product, comma separated; empty hides nothing).
other_pad() {
    awk 'BEGIN { RS = "" } /Handlers=[^\n]*js[0-9]/ && !/Vendor=28de/ { found = 1 } END { exit !found }' \
        /proc/bus/input/devices 2>/dev/null
}
if [ -n "${MEGA65_PAD_IGNORE+x}" ]; then
    export SDL_GAMECONTROLLER_IGNORE_DEVICES="$MEGA65_PAD_IGNORE"
elif other_pad; then
    export SDL_GAMECONTROLLER_IGNORE_DEVICES=0x28de/0x1205
fi

TC=$(cd "$(dirname "$0")/../.." && pwd)
XEMU="$TC/xemu/build/bin/xmega65.native"
ROM="$TC/rom/MEGA65.ROM"

if [ ! -x "$XEMU" ]; then
    echo "Xemu missing: make -C $TC/xemu" >&2
    exit 1
fi
if [ ! -f "$ROM" ]; then
    echo "MEGA65.ROM missing: $TC/rom/build-rom.sh" >&2
    exit 1
fi
exec "$XEMU" -rom "$ROM" "$@"
