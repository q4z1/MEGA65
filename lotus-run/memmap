# Lotus Run: the memory the linker does not place, and the files on
# the disk - for toolchain/tools/bin/mega65-mem. The numbers are src/mem.h's.

# Bank 0
ram  $0400+1024      the projection's depth steps (render.c)
ram  $0800+3072      DMA list being collected (dma.c)

ram  $E000+4352      the course, under the KERNAL (main.c, TRACK_BUF)

# Bank 1
ram  $10000+2000     screen: 40x25 characters of 2 bytes (video.c)
ram  $10800+40000    conversion list: picture to characters, 1600 jobs (video.c)
ram  $1A500+21248    the race's sound samples, copied from SOUNDS before each race (sound.c)

# Banks 4 and 5
ram  $40000+64000    the picture being drawn: 320x200 bytes (fb_mega65.c)
ram  $50000+64000    the characters on screen: 1000 x 64 bytes (video.c)

# Attic RAM: the course's backdrop, panel and sprite banks, one byte per
# pixel; the pages; the road line patterns as pixels
ram  $8000000+30720  the course's backdrop, 960 x 32 (banks.c)
ram  $8007800+4416   the panel as shown (panel.c)
ram  $8008A00+36864  the panel and its values' pictures (PANEL, banks.c)
ram  $8011A00+14336  the lap bar's pictures (LAPBAR, banks.c)
ram  $8015200+262144 sprite banks (the course's, about 200K; banks.c)
ram  $8100000+131072 a page as loaded from the disk (pages.c)
ram  $8120000+3456   the text font, 8 x 16 pixels a glyph (GLYPHS, pages.c)
ram  $8130000+4000   a page's screen or colour RAM before it is put together (pages.c)
ram  $8140000+1000   names: opponents, course record holders (TEXTS, season.c)
ram  $8148000+20426  the race's sound samples (SOUNDS, sound.c)
ram  $8150000+8192   road line pattern index: where each is in ROADPIX (road_pixels.c)
ram  $8154000+8186   the pages' code (MENU, main.c), copied to $E000 between the races
ram  $8158000+4352   the course coming next, as on the disk (main.c)
ram  $8200000+1245184 road line patterns drawn out, stripe set A (ROADPIX, road_pixels.c)
ram  $8330000+1245184 the same in the colours of stripe set B (ROADPIX_B)

# Colour RAM, cleared to 0: no attributes (video.c)
ram  $FF80000+2000   colour RAM for 40x25 characters of 2 bytes (video.c)

# The disk (build.sh). The program itself is found by its contents.
file TRACK??         @$E000      a course (tools/mkdata.py)
file SPR??           @$40000     a sprite bank, unpacked to attic RAM (tools/mksprites.py)
file BACK?           @$40000     a backdrop, unpacked to attic RAM (tools/mksprites.py)
file PANEL           @$40000     the panel, unpacked to attic RAM (tools/mksprites.py)
file LAPBAR          @$40000     the lap bar, unpacked to attic RAM (tools/mksprites.py)
file TEXTS           @$8140000   names from the game program (tools/mkdata.py)
file SOUNDS          @$8148000   the race's sound samples (tools/mkdata.py)
file MENU            @$8154000   the pages' code: link.ld's .menu (build.sh)
file TRACK??         @$8158000   the course coming next (main.c)
